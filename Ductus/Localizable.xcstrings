    "The menu bar changes the next time Ductus opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menüleiste ändert sich beim nächsten Öffnen von Ductus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar changes the next time Ductus opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús cambiará la próxima vez que abras Ductus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre des menus changera à la prochaine ouverture de Ductus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei menu cambierà alla prossima apertura di Ductus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーは次にDuctusを開いたときに切り替わります。"
