    "Your Mac's layout cannot type %@, so Ductus uses %@ in its windows. Other apps keep %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لتخطيط الـ Mac الكتابة بـ %1$@، لذا يستخدم Ductus التخطيط %2$@ في نوافذه. تحتفظ التطبيقات الأخرى بـ %3$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozložení vašeho Macu neumožňuje psát v jazyce %1$@, a tak Ductus ve svých oknech používá %2$@. Ostatní aplikace si ponechají %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Belegung deines Mac lässt sich %1$@ nicht tippen, daher nutzt Ductus in seinen Fenstern %2$@. Andere Apps behalten %3$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διάταξη του Mac σας δεν μπορεί να πληκτρολογήσει %1$@, οπότε το Ductus χρησιμοποιεί τη διάταξη %2$@ στα παράθυρά του. Οι άλλες εφαρμογές κρατούν τη διάταξη %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Mac's layout cannot type %@, so Ductus uses %@ in its windows. Other apps keep %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La distribución de tu Mac no permite escribir en %1$@, así que Ductus usa %2$@ en sus ventanas. Las demás apps mantienen %3$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با چیدمان Mac شما نمی‌توان %1$@ تایپ کرد، بنابراین Ductus در پنجره‌های خودش از %2$@ استفاده می‌کند. برنامه‌های دیگر %3$@ را نگه می‌دارند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition de votre Mac ne permet pas de taper en %1$@, donc Ductus utilise %2$@ dans ses fenêtres. Les autres apps gardent %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפריסה של ה-Mac שלך לא יכולה להקליד %1$@, לכן Ductus משתמש ב-%2$@ בחלונות שלו. יישומים אחרים שומרים על %3$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके Mac का लेआउट %1$@ टाइप नहीं कर सकता, इसलिए Ductus अपनी विंडो में %2$@ का उपयोग करता है। दूसरी ऐप्स %3$@ रखती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Maced kiosztásával nem lehet %1$@ nyelven gépelni, ezért a Ductus a saját ablakaiban a(z) %2$@ kiosztást használja. A többi alkalmazás megtartja a(z) %3$@ kiosztást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il layout del Mac non si può digitare in %1$@, quindi Ductus usa %2$@ nelle sue finestre. Le altre app mantengono %3$@."
