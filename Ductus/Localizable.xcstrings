    "Every unlocked key must reach both before the next letter unlocks. Your stats are kept when you change these.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede freigeschaltete Taste muss beides erreichen, bevor der nächste Buchstabe freigeschaltet wird. Deine Statistik bleibt erhalten, wenn du das änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every unlocked key must reach both before the next letter unlocks. Your stats are kept when you change these."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tecla desbloqueada debe alcanzar ambos antes de desbloquear la siguiente letra. Tus estadísticas se conservan si los cambias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque touche débloquée doit atteindre les deux avant que la lettre suivante soit débloquée. Vos statistiques sont conservées si vous les modifiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tasto sbloccato deve raggiungere entrambi i valori prima che si sblocchi la lettera successiva. Le tue statistiche restano se li modifichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の文字を解放するには、解放済みのすべてのキーが両方の目標に達する必要があります。これらを変更しても統計は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 글자가 잠금 해제되려면 잠금 해제된 모든 키가 두 목표를 모두 달성해야 합니다. 이 값을 바꿔도 통계는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ontgrendelde toets moet beide halen voordat de volgende letter wordt ontgrendeld. Je statistieken blijven bewaard als je deze wijzigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tecla desbloqueada precisa atingir os dois valores antes que a próxima letra seja desbloqueada. Suas estatísticas são mantidas se você mudar esses valores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个已解锁的键都必须同时达到这两项，才会解锁下一个字母。更改这些设置不会清除你的统计数据。"
          }
        }
      }
    },
