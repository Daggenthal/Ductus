    "Daily goal. Drill typing time and races both count." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدف اليومي. يُحتسب وقت الكتابة في التمارين والسباقات معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagesziel. Tippzeit in Übungen und Rennen zählen beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily goal. Drill typing time and races both count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivo diario. Cuentan tanto el tiempo de escritura en ejercicios como las carreras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectif quotidien. Le temps de frappe des exercices et les courses comptent tous les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivo giornaliero. Contano sia il tempo negli esercizi sia le gare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の目標です。ドリルの入力時間とレースの両方が数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일일 목표입니다. 드릴 입력 시간과 레이스 모두 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagdoel. Typtijd in oefeningen en races tellen allebei mee."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta diária. O tempo nos exercícios e as corridas contam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель на день. Учитывается время набора в упражнениях и заездах."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
