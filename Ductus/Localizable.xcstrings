            "state": "translated",
            "value": "GitHubにはまだリリースがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 아직 릴리스가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen versies op GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há versões no GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
