    "Race keystrokes count toward your key stats, so practice drills will target these keys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب ضغطات السباق ضمن إحصاءات مفاتيحك، لذا ستستهدف تمارين التدرّب هذه المفاتيح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úhozy ze závodů se počítají do statistik kláves, takže cvičení se zaměří na tyto klávesy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anschläge aus Rennen zählen zu deiner Tastenstatistik, daher nehmen sich die Übungen diese Tasten vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πλήκτρα των αγώνων μετράνε στα στατιστικά πλήκτρων σας, οπότε οι ασκήσεις εξάσκησης θα στοχεύουν αυτά τα πλήκτρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race keystrokes count toward your key stats, so practice drills will target these keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pulsaciones de las carreras cuentan para las estadísticas de tus teclas, así que los ejercicios de práctica se centrarán en estas teclas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلیدهای فشرده‌شده در مسابقه در آمار کلیدهای شما حساب می‌شوند، پس تمرین‌ها روی همین کلیدها تمرکز خواهند کرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frappes des courses comptent dans les statistiques de vos touches, donc les exercices de pratique cibleront ces touches."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשות במרוצים נספרות בנתוני המקשים שלך, כך שתרגילי התרגול יתמקדו במקשים אלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेस की कीस्ट्रोक आपके की आँकड़ों में गिनी जाती हैं, इसलिए अभ्यास इन्हीं कीज़ पर ध्यान देंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versenyek leütései beszámítanak a billentyűstatisztikádba, így a gyakorlatok ezekre a billentyűkre fognak összpontosítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti premuti nelle gare contano per le statistiche dei tasti, quindi gli esercizi si concentreranno su questi tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レースの打鍵もキーの統計に数えられるので、練習ドリルはこれらのキーを重点的に扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이스 키 입력도 키 통계에 포함되므로, 연습 드릴이 이 키들을 집중적으로 다룹니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toetsaanslagen in races tellen mee voor je toetsstatistieken, dus oefeningen richten zich op deze toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnięcia w wyścigach liczą się do statystyk klawiszy, więc ćwiczenia skupią się na tych klawiszach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas das corridas contam para as estatísticas das teclas, então os exercícios vão focar nessas teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатия в заездах учитываются в статистике клавиш, поэтому упражнения будут нацелены на эти клавиши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarışlardaki tuş vuruşları tuş istatistiklerinize sayılır, bu yüzden pratik alıştırmaları bu tuşları hedefler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискання в забігах зараховуються до статистики клавіш, тож вправи будуть націлені на ці клавіші."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "竞速的按键会计入你的按键统计，因此练习训练会针对这些键。"
          }
        }
      }
    },
