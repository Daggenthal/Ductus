    "You were on %@ before. Your progress and settings are just as you left them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كنت تستخدم %@ من قبل. تقدمك وإعداداتك كما تركتها تمامًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předtím jste měli verzi %@. Váš postup a nastavení zůstaly tak, jak jste je opustili."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorher hattest du %@. Dein Fortschritt und deine Einstellungen sind genau wie zuvor."
