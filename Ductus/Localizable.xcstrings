            "value" : "A szavak és mondatok a Project Gutenberg közkincs könyveiből és a Tatoeba közreműködőitől (CC BY 2.0 FR) származnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parole e frasi provengono da libri di pubblico dominio su Project Gutenberg e dai collaboratori di Tatoeba (CC BY 2.0 FR)."
