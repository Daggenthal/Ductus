            "value" : "Prima usavi la versione %@. I tuoi progressi e le impostazioni sono come li avevi lasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前は%@を使っていました。進捗と設定はそのままです。"
