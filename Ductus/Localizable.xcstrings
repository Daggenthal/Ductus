    "Just start typing. Mistakes keep the cursor in place until you hit the right key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ الكتابة فقط. عند الخطأ يبقى المؤشر في مكانه حتى تضغط المفتاح الصحيح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostě začněte psát. Při chybě zůstane kurzor na místě, dokud nestisknete správnou klávesu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang einfach an zu tippen. Bei Fehlern bleibt der Cursor stehen, bis du die richtige Taste drückst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απλώς αρχίστε να πληκτρολογείτε. Τα λάθη κρατούν τον κέρσορα στη θέση του μέχρι να πατήσετε το σωστό πλήκτρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just start typing. Mistakes keep the cursor in place until you hit the right key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a escribir. Si te equivocas, el cursor no avanza hasta que pulses la tecla correcta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط شروع به تایپ کنید. با هر اشتباه، مکان‌نما سر جایش می‌ماند تا کلید درست را بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez simplement à taper. En cas d’erreur, le curseur reste en place jusqu’à la bonne touche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פשוט התחל להקליד. בטעות, הסמן נשאר במקומו עד שתקיש על המקש הנכון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस टाइप करना शुरू करें। गलती होने पर कर्सर तब तक वहीं रुका रहता है जब तक आप सही की नहीं दबाते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak kezdj el gépelni. Hiba esetén a kurzor a helyén marad, amíg a helyes billentyűt le nem nyomod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a scrivere. Con un errore il cursore resta fermo finché non premi il tasto giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのまま入力を始めてください。間違えると、正しいキーを押すまでカーソルは進みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바로 입력을 시작하십시오. 틀리면 올바른 키를 누를 때까지 커서가 그 자리에 머뭅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin gewoon met typen. Bij een fout blijft de cursor staan tot je de juiste toets indrukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po prostu zacznij pisać. Przy błędzie kursor stoi w miejscu, dopóki nie naciśniesz właściwego klawisza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só começar a digitar. Com um erro, o cursor fica parado até você pressionar a tecla certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто начните печатать. При ошибке курсор стоит на месте, пока вы не нажмете нужную клавишу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmaya başlamanız yeterli. Hata yaptığınızda imleç, doğru tuşa basana kadar yerinde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто почніть друкувати. Після помилки курсор стоїть на місці, доки ви не натиснете правильну клавішу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接开始打字。打错时，光标会停在原处，直到你按下正确的键。"
          }
        }
      }
    },
    "Just start typing. Your keys count toward practice, like races do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ الكتابة فقط. تُحتسب ضغطاتك ضمن التدرّب، كما في السباقات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostě začněte psát. Vaše úhozy se počítají do cvičení stejně jako u závodů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang einfach an zu tippen. Deine Anschläge zählen wie bei Rennen zum Üben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απλώς αρχίστε να πληκτρολογείτε. Τα πλήκτρα σας μετράνε στην εξάσκηση, όπως και στους αγώνες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just start typing. Your keys count toward practice, like races do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a escribir. Tus pulsaciones cuentan para la práctica, como en las carreras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط شروع به تایپ کنید. کلیدهای شما مانند مسابقه‌ها در تمرین حساب می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez simplement à taper. Vos frappes comptent pour la pratique, comme les courses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פשוט התחל להקליד. ההקשות שלך נספרות בתרגול, כמו במרוצים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस टाइप करना शुरू करें। रेस की तरह, आपकी कीज़ अभ्यास में गिनी जाती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak kezdj el gépelni. A leütéseid a versenyekhez hasonlóan beszámítanak a gyakorlásba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a scrivere. I tuoi tasti contano per la pratica, come nelle gare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのまま入力を始めてください。レースと同じく、入力したキーは練習に数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바로 입력을 시작하십시오. 레이스처럼 입력한 키가 연습에 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin gewoon met typen. Je toetsaanslagen tellen mee voor het oefenen, net als bij races."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po prostu zacznij pisać. Naciśnięcia klawiszy liczą się do ćwiczeń, tak jak w wyścigach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só começar a digitar. Suas teclas contam para a prática, como nas corridas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто начните печатать. Ваши нажатия засчитываются в практику, как и в заездах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazmaya başlamanız yeterli. Bastığınız tuşlar, yarışlarda olduğu gibi pratiğe sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто почніть друкувати. Ваші натискання зараховуються до практики, як і в забігах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接开始打字。和竞速一样，你的按键会计入练习。"
          }
        }
      }
    },
    "Keep going, fix with Backspace" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتابعة، والتصحيح بمفتاح الحذف"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračovat, opravit klávesou Backspace"
          }
        },
