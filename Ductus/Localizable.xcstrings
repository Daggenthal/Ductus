        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frissítést nem sikerült telepíteni, ezért a jelenlegi verzió maradt meg. A részletek itt találhatók: ~/Library/Logs/DuctusUpdater.log."
