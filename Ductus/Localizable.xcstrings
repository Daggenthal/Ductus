            "state": "translated",
            "value": "La dernière version n’a pas pu être lue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'ultima versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
