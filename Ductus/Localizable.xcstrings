    "A faint QWERTY letter in the corner of each key, showing what is printed on your real keyboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein blasser QWERTY-Buchstabe in der Ecke jeder Taste zeigt, was auf deiner echten Tastatur steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A faint QWERTY letter in the corner of each key, showing what is printed on your real keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una letra QWERTY tenue en la esquina de cada tecla, que muestra lo que está impreso en tu teclado real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lettre QWERTY discrète dans le coin de chaque touche, qui montre ce qui est imprimé sur votre vrai clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettera QWERTY tenue nell'angolo di ogni tasto, che mostra cosa è stampato sulla tua tastiera reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーの隅にQWERTYの文字を薄く表示します。実際のキーボードに印字されている文字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키 모서리에 QWERTY 글자를 흐리게 표시합니다. 실제 키보드에 인쇄된 글자입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vage QWERTY-letter in de hoek van elke toets, die laat zien wat er op je echte toetsenbord staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma letra QWERTY clara no canto de cada tecla, mostrando o que está impresso no seu teclado real."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个键的角落淡淡显示 QWERTY 字母，也就是你实际键盘上印的字母。"
          }
        }
      }
    },
    "A typing tutor for learning a new keyboard layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipptrainer zum Lernen einer neuen Tastaturbelegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A typing tutor for learning a new keyboard layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tutor de mecanografía para aprender una nueva distribución de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tuteur de dactylographie pour apprendre une nouvelle disposition de clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma per imparare a scrivere con un nuovo layout di tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいキーボード配列を覚えるためのタイピング練習アプリ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 키보드 배열을 익히기 위한 타자 연습 앱."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een typcursus om een nieuwe toetsenbordindeling te leren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tutor de digitação para aprender um novo layout de teclado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮你学习新键盘布局的打字教练。"
          }
        }
      }
    },
