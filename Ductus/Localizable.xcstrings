    "System follows your macOS setting. Applies to the floating keyboard too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار النظام يتبع إعداد macOS. ينطبق على لوحة المفاتيح العائمة أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt deiner macOS-Einstellung. Gilt auch für die schwebende Tastatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your macOS setting. Applies to the floating keyboard too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue tu ajuste de macOS. También se aplica al teclado flotante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit votre réglage macOS. S’applique aussi au clavier flottant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l'impostazione di macOS. Vale anche per la tastiera mobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」はmacOSの設定に従います。フローティングキーボードにも適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 macOS 설정을 따릅니다. 플로팅 키보드에도 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeem volgt je macOS-instelling. Geldt ook voor het zwevende toetsenbord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue o ajuste do macOS. Vale também para o teclado flutuante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Системное» следует настройке macOS. Применяется и к плавающей клавиатуре."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Системний» відповідає параметру macOS. Застосовується й до плаваючої клавіатури."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”跟随你的 macOS 设置，也适用于浮动键盘。"
          }
        }
      }
