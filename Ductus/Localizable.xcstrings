    "This deletes your key stats, unlocked letters and history for this layout. It cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف إحصاءات مفاتيحك والحروف المفتوحة والسجل لهذا التخطيط. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden deine Tastenstatistik, die freigeschalteten Buchstaben und der Verlauf für diese Belegung gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes your key stats, unlocked letters and history for this layout. It cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina las estadísticas de tus teclas, las letras desbloqueadas y el historial de esta distribución. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les statistiques de vos touches, les lettres débloquées et l’historique pour cette disposition. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione elimina le statistiche dei tasti, le lettere sbloccate e la cronologia per questo layout. Non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この配列のキーの統計、解放した文字、履歴が削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 배열의 키 통계, 잠금 해제한 글자, 기록이 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert je toetsstatistieken, ontgrendelde letters en geschiedenis voor deze indeling. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga as estatísticas das teclas, as letras desbloqueadas e o histórico deste layout. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены статистика клавиш, открытые буквы и история для этой раскладки. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде видалено статистику клавіш, відкриті літери та історію для цієї розкладки. Цю дію неможливо скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除此布局的按键统计、已解锁字母和历史记录。此操作无法撤销。"
          }
        }
      }
    },
