    "The download did not match its checksum, so it was deleted. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يطابق التنزيل المجموع الاختباري الخاص به، لذا تم حذفه. حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download passte nicht zu seiner Prüfsumme und wurde gelöscht. Versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download did not match its checksum, so it was deleted. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
