            "value" : "جمل من Tatoeba (tatoeba.org) بموجب ترخيص CC BY 2.0 FR، من هؤلاء المساهمين. معرّف كل جملة ومؤلفها مدرجان في ملفات الشكر في الكود المصدري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätze von Tatoeba (tatoeba.org) unter CC BY 2.0 FR, von diesen Mitwirkenden. ID und Autor jedes Satzes stehen in den Credits-Dateien im Quellcode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentences from Tatoeba (tatoeba.org) under CC BY 2.0 FR, by these contributors. Each sentence's ID and author is listed in the credits files in the source code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frases de Tatoeba (tatoeba.org) con licencia CC BY 2.0 FR, de estos colaboradores. El ID y el autor de cada frase figuran en los archivos de créditos del código fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
