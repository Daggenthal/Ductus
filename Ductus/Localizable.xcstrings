    "Race keystrokes count toward your key stats, so practice drills will target these keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anschläge aus Rennen zählen zu deiner Tastenstatistik, daher nehmen sich die Übungen diese Tasten vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race keystrokes count toward your key stats, so practice drills will target these keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pulsaciones de las carreras cuentan para las estadísticas de tus teclas, así que los ejercicios de práctica se centrarán en estas teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frappes des courses comptent dans les statistiques de vos touches, donc les exercices de pratique cibleront ces touches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti premuti nelle gare contano per le statistiche dei tasti, quindi gli esercizi si concentreranno su questi tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レースの打鍵もキーの統計に数えられるので、練習ドリルはこれらのキーを重点的に扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이스 키 입력도 키 통계에 포함되므로, 연습 드릴이 이 키들을 집중적으로 다룹니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetsaanslagen in races tellen mee voor je toetsstatistieken, dus oefeningen richten zich op deze toetsen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas das corridas contam para as estatísticas das teclas, então os exercícios vão focar nessas teclas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竞速的按键会计入你的按键统计，因此练习训练会针对这些键。"
          }
        }
      }
    },
