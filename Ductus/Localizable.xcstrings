    "Paste an article, a book chapter or some code. You type it part by part, and your keys count toward practice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Artikel, ein Buchkapitel oder Code ein. Du tippst ihn Teil für Teil, und deine Anschläge zählen zum Üben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an article, a book chapter or some code. You type it part by part, and your keys count toward practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un artículo, un capítulo de un libro o algo de código. Lo escribes parte por parte, y tus pulsaciones cuentan para la práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un article, un chapitre de livre ou du code. Vous le tapez partie par partie, et vos frappes comptent pour la pratique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un articolo, un capitolo di un libro o del codice. Lo digiti parte per parte e i tuoi tasti contano per la pratica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事や本の一章、コードなどを貼り付けてください。パートごとに入力し、入力したキーは練習に数えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사, 책의 한 장, 코드 등을 붙여넣으십시오. 파트별로 입력하며, 입력한 키는 연습에 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een artikel, een hoofdstuk uit een boek of wat code. Je typt het deel voor deel, en je toetsaanslagen tellen mee voor het oefenen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um artigo, um capítulo de livro ou um trecho de código. Você digita parte por parte, e suas teclas contam para a prática."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴一篇文章、一章书或一段代码。你会一部分一部分地输入，按键会计入练习。"
          }
        }
      }
    },
