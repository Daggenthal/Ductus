    "Keeps the words and the keys close together so your eyes do not have to travel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält Wörter und Tasten nah beieinander, damit deine Augen nicht wandern müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the words and the keys close together so your eyes do not have to travel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las palabras y las teclas juntas para que tus ojos no tengan que moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les mots et les touches proches pour que vos yeux n’aient pas à se déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene vicini le parole e i tasti, così gli occhi non devono spostarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語とキーを近くに置き、視線の移動を少なくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어와 키를 가까이 두어 시선 이동을 줄입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt de woorden en de toetsen dicht bij elkaar, zodat je ogen niet ver hoeven te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém as palavras e as teclas próximas, para que seus olhos não precisem se deslocar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让文字和键盘靠得更近，减少视线移动。"
          }
        }
      }
    },
