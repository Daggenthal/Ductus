        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द और वाक्य Project Gutenberg की पब्लिक डोमेन किताबों और Tatoeba के योगदानकर्ताओं (CC BY 2.0 FR) से लिए गए हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
