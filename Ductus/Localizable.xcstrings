    "System follows your macOS setting. Applies to the floating keyboard too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار النظام يتبع إعداد macOS. ينطبق على لوحة المفاتيح العائمة أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém se řídí nastavením macOS. Platí i pro plovoucí klávesnici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt deiner macOS-Einstellung. Gilt auch für die schwebende Tastatur."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Σύστημα» ακολουθεί τη ρύθμιση του macOS. Ισχύει και για το αιωρούμενο πληκτρολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your macOS setting. Applies to the floating keyboard too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue tu ajuste de macOS. También se aplica al teclado flotante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزینهٔ «سیستم» از تنظیم macOS شما پیروی می‌کند. روی صفحه‌کلید شناور هم اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit votre réglage macOS. S’applique aussi au clavier flottant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״מערכת״ עוקב אחר הגדרת macOS שלך. חל גם על המקלדת הצפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम आपकी macOS सेटिंग का पालन करता है। यह फ़्लोटिंग कीबोर्ड पर भी लागू होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rendszer a macOS beállításodat követi. A lebegő billentyűzetre is vonatkozik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l'impostazione di macOS. Vale anche per la tastiera mobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」はmacOSの設定に従います。フローティングキーボードにも適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 macOS 설정을 따릅니다. 플로팅 키보드에도 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeem volgt je macOS-instelling. Geldt ook voor het zwevende toetsenbord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemowy działa zgodnie z ustawieniem macOS. Dotyczy także pływającej klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue o ajuste do macOS. Vale também para o teclado flutuante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Системное» следует настройке macOS. Применяется и к плавающей клавиатуре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem, macOS ayarınızı izler. Yüzen klavyeye de uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Системний» відповідає параметру macOS. Застосовується й до плаваючої клавіатури."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统”跟随你的 macOS 设置，也适用于浮动键盘。"
          }
        }
      }
    },
