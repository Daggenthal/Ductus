    "Live speed and accuracy, the last drill, your focus key and unlock progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السرعة والدقة مباشرة، وآخر تمرين، ومفتاح التركيز، وتقدّم فتح الحروف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Tempo und Genauigkeit, die letzte Übung, deine Fokustaste und der Freischaltfortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live speed and accuracy, the last drill, your focus key and unlock progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad y precisión en directo, el último ejercicio, tu tecla en foco y el progreso de desbloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse et précision en direct, le dernier exercice, votre touche ciblée et la progression du déblocage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità e precisione in tempo reale, l'ultimo esercizio, il tasto focus e i progressi di sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の速度と正確率、前回のドリル、重点キー、解放の進み具合。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 속도와 정확도, 마지막 드릴, 집중 키, 잠금 해제 진행 상황."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live snelheid en nauwkeurigheid, de laatste oefening, je focustoets en ontgrendelvoortgang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade e precisão ao vivo, o último exercício, a tecla em foco e o progresso de desbloqueio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая скорость и точность, последнее упражнение, ключевая клавиша и прогресс открытия букв."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточні швидкість і точність, остання вправа, клавіша у фокусі та поступ відкриття."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时速度和准确率、上一次训练、重点键以及解锁进度。"
          }
        }
      }
    },
