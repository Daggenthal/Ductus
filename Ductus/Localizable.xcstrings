    "A faint QWERTY letter in the corner of each key, showing what is printed on your real keyboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف QWERTY باهت في زاوية كل مفتاح، يبيّن ما هو مطبوع على لوحة المفاتيح الحقيقية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein blasser QWERTY-Buchstabe in der Ecke jeder Taste zeigt, was auf deiner echten Tastatur steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faint QWERTY letter in the corner of each key, showing what is printed on your real keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una letra QWERTY tenue en la esquina de cada tecla, que muestra lo que está impreso en tu teclado real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lettre QWERTY discrète dans le coin de chaque touche, qui montre ce qui est imprimé sur votre vrai clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lettera QWERTY tenue nell'angolo di ogni tasto, che mostra cosa è stampato sulla tua tastiera reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各キーの隅にQWERTYの文字を薄く表示します。実際のキーボードに印字されている文字です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 키 모서리에 QWERTY 글자를 흐리게 표시합니다. 실제 키보드에 인쇄된 글자입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vage QWERTY-letter in de hoek van elke toets, die laat zien wat er op je echte toetsenbord staat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma letra QWERTY clara no canto de cada tecla, mostrando o que está impresso no seu teclado real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бледная буква QWERTY в углу каждой клавиши показывает, что напечатано на вашей настоящей клавиатуре."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бліда літера QWERTY у куті кожної клавіші показує, що надруковано на вашій справжній клавіатурі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个键的角落淡淡显示 QWERTY 字母，也就是你实际键盘上印的字母。"
          }
        }
      }
    },
