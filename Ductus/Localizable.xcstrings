    "GitHub did not answer as expected. Try again in a little while.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat nicht wie erwartet geantwortet. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub did not answer as expected. Try again in a little while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no ha respondido como se esperaba. Vuelve a intentarlo en un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas répondu comme prévu. Réessayez dans un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha risposto come previsto. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubから想定どおりの応答がありませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 예상한 응답이 오지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nl": {
