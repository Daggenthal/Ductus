    "Unlocked only: your unlocked letters, weighted toward your weak keys like practice. Sentences: real sentences from books." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتوحة فقط: حروفك المفتوحة، مع التركيز على مفاتيحك الضعيفة كما في التدرّب. الجمل: جمل حقيقية من الكتب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur freigeschaltete: Deine freigeschalteten Buchstaben, mit Schwerpunkt auf schwachen Tasten wie beim Üben. Sätze: Echte Sätze aus Büchern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocked only: your unlocked letters, weighted toward your weak keys like practice. Sentences: real sentences from books."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo desbloqueadas: tus letras desbloqueadas, con más peso en tus teclas débiles, como en la práctica. Frases: frases reales de libros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquées uniquement : vos lettres débloquées, en privilégiant vos touches faibles comme en pratique. Phrases : de vraies phrases tirées de livres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo sbloccate: le lettere sbloccate, con più peso sui tasti deboli come nella pratica. Frasi: frasi vere tratte da libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放済みのみ: 解放した文字を使い、練習と同じく苦手なキーを多めにします。文: 本の実際の文です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제된 글자만: 잠금 해제한 글자를 사용하며, 연습처럼 약한 키에 비중을 둡니다. 문장: 책의 실제 문장입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen ontgrendeld: je ontgrendelde letters, met nadruk op je zwakke toetsen, zoals bij oefenen. Zinnen: echte zinnen uit boeken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só desbloqueadas: suas letras desbloqueadas, com mais peso nas teclas fracas, como na prática. Frases: frases reais de livros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только открытые: ваши открытые буквы с упором на слабые клавиши, как в практике. Предложения: настоящие предложения из книг."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише відкриті: ваші відкриті літери з наголосом на слабких клавішах, як у практиці. Речення: справжні речення з книжок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅已解锁：使用你已解锁的字母，像练习一样偏重你的弱键。句子：书中的真实句子。"
          }
        }
      }
    },
