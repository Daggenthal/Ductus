    "Words and sentences come from public-domain books on Project Gutenberg and from Tatoeba contributors (CC BY 2.0 FR)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمات والجمل مأخوذة من كتب الملكية العامة في Project Gutenberg ومن مساهمي Tatoeba (CC BY 2.0 FR)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slova a věty pocházejí z volných knih (public domain) z Project Gutenberg a od přispěvatelů Tatoeba (CC BY 2.0 FR)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter und Sätze stammen aus gemeinfreien Büchern bei Project Gutenberg und von Mitwirkenden bei Tatoeba (CC BY 2.0 FR)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι λέξεις και οι προτάσεις προέρχονται από βιβλία κοινού κτήματος στο Project Gutenberg και από συνεισφέροντες του Tatoeba (CC BY 2.0 FR)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words and sentences come from public-domain books on Project Gutenberg and from Tatoeba contributors (CC BY 2.0 FR)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras y frases vienen de libros de dominio público de Project Gutenberg y de colaboradores de Tatoeba (CC BY 2.0 FR)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژه‌ها و جمله‌ها از کتاب‌های مالکیت عمومی در Project Gutenberg و از مشارکت‌کنندگان Tatoeba (CC BY 2.0 FR) گرفته شده‌اند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots et les phrases viennent de livres du domaine public sur Project Gutenberg et des contributeurs de Tatoeba (CC BY 2.0 FR)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המילים והמשפטים לקוחים מספרים בנחלת הכלל ב-Project Gutenberg ומתורמי Tatoeba (CC BY 2.0 FR)."
