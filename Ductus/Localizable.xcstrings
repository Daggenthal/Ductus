    "Keeps the words and the keys close together so your eyes do not have to travel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي الكلمات والمفاتيح قريبة من بعضها حتى لا تضطر عيناك إلى التنقل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržuje slova a klávesy blízko sebe, aby oči nemusely přebíhat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Wörter und Tasten nah beieinander, damit deine Augen nicht wandern müssen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατά τις λέξεις και τα πλήκτρα κοντά, ώστε τα μάτια σας να μη χρειάζεται να μετακινούνται πολύ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the words and the keys close together so your eyes do not have to travel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene las palabras y las teclas juntas para que tus ojos no tengan que moverse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واژه‌ها و کلیدها را نزدیک هم نگه می‌دارد تا چشمانتان مجبور به جابه‌جایی نباشند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde les mots et les touches proches pour que vos yeux n’aient pas à se déplacer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר את המילים והמקשים קרובים זה לזה כדי שהעיניים לא יצטרכו לנדוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्दों और कीज़ को पास-पास रखता है, ताकि आपकी आँखों को दूर न जाना पड़े।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szavakat és a billentyűket egymás közelében tartja, hogy ne kelljen ide-oda nézned."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene vicini le parole e i tasti, così gli occhi non devono spostarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語とキーを近くに置き、視線の移動を少なくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어와 키를 가까이 두어 시선 이동을 줄입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de woorden en de toetsen dicht bij elkaar, zodat je ogen niet ver hoeven te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Słowa i klawisze są blisko siebie, więc wzrok nie musi daleko wędrować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém as palavras e as teclas próximas, para que seus olhos não precisem se deslocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слова и клавиши располагаются рядом, чтобы взгляду не приходилось далеко перемещаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözcükleri ve tuşları birbirine yakın tutar, böylece gözlerinizin uzağa gitmesi gerekmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримає слова й клавіші поруч, щоб очам не доводилося переміщатися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让文字和键盘靠得更近，减少视线移动。"
          }
        }
      }
    },
