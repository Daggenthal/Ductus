    "Type on the 2-Set Korean layout. Each block fills in as you type its keys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب بالتخطيط الكوري 2-Set. تمتلئ كل كتلة كلما كتبت مفاتيحها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe mit der koreanischen 2-Set-Belegung. Jeder Block füllt sich, während du seine Tasten tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type on the 2-Set Korean layout. Each block fills in as you type its keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe con la distribución coreana 2-Set. Cada bloque se completa a medida que escribes sus teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez avec la disposition coréenne 2-Set. Chaque bloc se remplit à mesure que vous tapez ses touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con il layout coreano 2-Set. Ogni blocco si completa mentre digiti i suoi tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語の2ボル式配列で入力します。キーを押すと、文字のブロックが組み上がっていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한국어 두벌식 배열로 입력합니다. 키를 누르면 글자가 하나씩 조합됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ op de Koreaanse 2-Set-indeling. Elk blok vult zich terwijl je de toetsen ervan typt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite no layout coreano 2-Set. Cada bloco se completa à medida que você digita as teclas dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Печатайте в корейской раскладке 2-Set. Каждый слог заполняется по мере набора его клавиш."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друкуйте в корейській розкладці 2-Set. Кожен блок заповнюється, коли ви друкуєте його клавіші."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用韩文两套式布局输入。随着你按键，每个字块会逐步拼成。"
          }
        }
      }
    },
