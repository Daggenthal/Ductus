    "Practice with real sentences from books, using only your unlocked letters, weighted toward your weak keys." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب بجمل حقيقية من الكتب، بحروفك المفتوحة فقط، مع التركيز على مفاتيحك الضعيفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cvičte se skutečnými větami z knih, jen s odemčenými písmeny, se zaměřením na vaše slabé klávesy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe mit echten Sätzen aus Büchern, nur mit deinen freigeschalteten Buchstaben und mit Schwerpunkt auf deinen schwachen Tasten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξάσκηση με πραγματικές προτάσεις από βιβλία, μόνο με τα ξεκλείδωτα γράμματά σας, με έμφαση στα αδύναμα πλήκτρα σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice with real sentences from books, using only your unlocked letters, weighted toward your weak keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practica con frases reales de libros, usando solo tus letras desbloqueadas y con más peso en tus teclas débiles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با جمله‌های واقعی از کتاب‌ها تمرین کنید، فقط با حروف بازشده‌تان و با تأکید بر کلیدهای ضعیفتان."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratiquez avec de vraies phrases tirées de livres, avec seulement vos lettres débloquées, en privilégiant vos touches faibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תרגל עם משפטים אמיתיים מספרים, רק עם האותיות הפתוחות שלך, ובדגש על המקשים החלשים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किताबों के असली वाक्यों से अभ्यास करें, केवल आपके अनलॉक किए गए अक्षरों के साथ और आपकी कमज़ोर कीज़ पर ज़्यादा ज़ोर देते हुए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyakorolj valódi, könyvekből vett mondatokkal, csak a feloldott betűiddel, a gyenge billentyűidre helyezett hangsúllyal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esercitati con frasi vere tratte da libri, usando solo le lettere sbloccate, con più peso sui tasti deboli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本の実際の文で練習します。解放済みの文字だけを使い、苦手なキーを多めにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "책의 실제 문장으로 연습합니다. 잠금 해제한 글자만 사용하고, 약한 키에 더 비중을 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oefen met echte zinnen uit boeken, met alleen je ontgrendelde letters en met nadruk op je zwakke toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ćwicz na prawdziwych zdaniach z książek, tylko z odblokowanymi literami, z naciskiem na słabe klawisze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique com frases reais de livros, usando só suas letras desbloqueadas, com mais peso nas teclas fracas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практика на настоящих предложениях из книг, только с открытыми буквами, с упором на слабые клавиши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplardan gerçek cümlelerle, yalnızca kilidi açık harflerinizi kullanarak ve zayıf tuşlarınıza ağırlık vererek pratik yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практикуйтеся на справжніх реченнях із книжок, лише з відкритими літерами та з наголосом на слабких клавішах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用书中的真实句子练习，只用已解锁的字母，并偏重你的弱键。"
          }
        }
      }
    },
    "Press Return at each ↵. Indentation is skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على مفتاح Return عند كل ↵. يتم تخطي المسافات البادئة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
