    "Daily goal. Drill typing time and races both count." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدف اليومي. يُحتسب وقت الكتابة في التمارين والسباقات معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denní cíl. Počítá se čas psaní ve cvičeních i v závodech."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagesziel. Tippzeit in Übungen und Rennen zählen beide."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ημερήσιος στόχος. Μετράει ο χρόνος πληκτρολόγησης στις ασκήσεις και στους αγώνες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily goal. Drill typing time and races both count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivo diario. Cuentan tanto el tiempo de escritura en ejercicios como las carreras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هدف روزانه. زمان تایپ در تمرین‌ها و مسابقه‌ها هر دو حساب می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectif quotidien. Le temps de frappe des exercices et les courses comptent tous les deux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יעד יומי. גם זמן ההקלדה בתרגילים וגם מרוצים נספרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक लक्ष्य। अभ्यास में टाइपिंग का समय और रेस, दोनों गिने जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napi cél. A gyakorlatokban és a versenyekben töltött gépelési idő is beszámít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivo giornaliero. Contano sia il tempo negli esercizi sia le gare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の目標です。ドリルの入力時間とレースの両方が数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일일 목표입니다. 드릴 입력 시간과 레이스 모두 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagdoel. Typtijd in oefeningen en races tellen allebei mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel dzienny. Liczy się czas pisania w ćwiczeniach i wyścigach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta diária. O tempo nos exercícios e as corridas contam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цель на день. Учитывается время набора в упражнениях и заездах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük hedef. Alıştırmalarda yazma süresi ve yarışlar birlikte sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоденна мета. Зараховується і час друку у вправах, і забіги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日目标。训练的打字时间和竞速都会计入。"
          }
        }
      }
    },
