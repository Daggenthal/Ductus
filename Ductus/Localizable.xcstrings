    },
    "The updater did not start, so nothing was changed. Try again, or download the new version from GitHub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يبدأ برنامج التحديث، لذا لم يتغير شيء. حاول مرة أخرى، أو نزّل الإصدار الجديد من GitHub."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizační program se nespustil, takže se nic nezměnilo. Zkuste to znovu nebo si stáhněte novou verzi z GitHubu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Update-Programm ist nicht gestartet, daher wurde nichts geändert. Versuch es noch einmal oder lade die neue Version von GitHub."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρόγραμμα ενημέρωσης δεν ξεκίνησε, οπότε δεν άλλαξε τίποτα. Δοκιμάστε ξανά ή κάντε λήψη της νέας έκδοσης από το GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The updater did not start, so nothing was changed. Try again, or download the new version from GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El actualizador no se ha iniciado, así que no se ha cambiado nada. Vuelve a intentarlo o descarga la nueva versión desde GitHub."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
