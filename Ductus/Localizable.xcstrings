    "Japanese and Chinese you paste into the Text tab are read with the text tools built into macOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقرأ النصوص اليابانية والصينية التي تلصقها في علامة تبويب النص باستخدام أدوات النصوص المدمجة في macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japanisch und Chinesisch, das du im Tab „Text“ einfügst, wird mit den in macOS integrierten Textwerkzeugen gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japanese and Chinese you paste into the Text tab are read with the text tools built into macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El japonés y el chino que pegues en la pestaña Texto se leen con las herramientas de texto integradas en macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le japonais et le chinois collés dans l’onglet Texte sont lus avec les outils de texte intégrés à macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il giapponese e il cinese che incolli nella scheda Testo vengono letti con gli strumenti di testo integrati in macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「テキスト」タブに貼り付けた日本語と中国語は、macOSに内蔵されたテキストツールで読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 탭에 붙여넣은 일본어와 중국어는 macOS에 내장된 텍스트 도구로 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japans en Chinees dat je in de tab Tekst plakt, wordt gelezen met de teksttools die in macOS zijn ingebouwd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japonês e chinês colados na aba Texto são lidos com as ferramentas de texto integradas ao macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Японский и китайский текст, вставленный во вкладку «Текст», читается встроенными в macOS инструментами для текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Японський і китайський текст, вставлений на вкладці «Текст», читається вбудованими в macOS інструментами для тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴到“文本”标签页的日文和中文，会用 macOS 内置的文本工具来读取。"
