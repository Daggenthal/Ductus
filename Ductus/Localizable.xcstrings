    "Permission not granted yet. Turn on Ductus in Input Monitoring, then quit and reopen Ductus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُمنح الإذن بعد. شغّل Ductus في مراقبة الإدخال، ثم أنهِ Ductus وأعد فتحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigung noch nicht erteilt. Aktiviere Ductus unter „Eingabeüberwachung“, beende Ductus dann und öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission not granted yet. Turn on Ductus in Input Monitoring, then quit and reopen Ductus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha concedido el permiso. Activa Ductus en Monitorización de entrada y luego cierra y vuelve a abrir Ductus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation pas encore accordée. Activez Ductus dans Surveillance de l’entrée, puis quittez et rouvrez Ductus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesso non ancora concesso. Attiva Ductus in Monitoraggio input, poi esci e riapri Ductus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ許可されていません。入力監視でDuctusをオンにしてから、Ductusを終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 권한이 없습니다. 입력 모니터링에서 Ductus를 켠 다음, Ductus를 종료하고 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming nog niet gegeven. Zet Ductus aan bij Invoermonitoring, stop dan Ductus en open het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão ainda não concedida. Ative o Ductus em Monitoramento de Entrada, depois encerre e reabra o Ductus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение пока не выдано. Включите Ductus в разделе «Мониторинг ввода», затем закройте и снова откройте Ductus."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвіл ще не надано. Увімкніть Ductus у розділі «Моніторинг введення», потім закрийте й знову відкрийте Ductus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未获得权限。请在“输入监控”中打开 Ductus，然后退出并重新打开 Ductus。"
          }
        }
      }
    },
