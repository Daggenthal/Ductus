    "Not enough sentences use only your unlocked letters yet (%lld of %lld needed). Practice stays on words until then." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد بعد جمل كافية تستخدم حروفك المفتوحة فقط (%1$lld من %2$lld مطلوبة). يبقى التدرّب على الكلمات حتى ذلك الحين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht genug Sätze nutzen nur deine freigeschalteten Buchstaben (%lld von %lld nötig). Bis dahin übst du mit Wörtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough sentences use only your unlocked letters yet (%lld of %lld needed). Practice stays on words until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay suficientes frases que usen solo tus letras desbloqueadas (%lld de %lld necesarias). Hasta entonces, la práctica sigue con palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore assez de phrases n’utilisent que vos lettres débloquées (%lld sur %lld nécessaires). La pratique reste sur des mots d’ici là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono ancora abbastanza frasi che usano solo le lettere sbloccate (%lld di %lld necessarie). Fino ad allora la pratica resta sulle parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解放済みの文字だけでできた文がまだ足りません（必要な%2$lld件のうち%1$lld件）。それまでは単語で練習します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제한 글자만 사용하는 문장이 아직 부족합니다(필요한 %2$lld개 중 %1$lld개). 그때까지는 단어로 연습합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn nog niet genoeg zinnen met alleen je ontgrendelde letters (%lld van %lld nodig). Tot dan blijf je met woorden oefenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há frases suficientes que usam só suas letras desbloqueadas (%lld de %lld necessárias). Até lá, a prática continua com palavras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока недостаточно предложений только из открытых букв (%lld из %lld нужных). До тех пор практика идет на словах."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки що замало речень, які містять лише відкриті літери (потрібно %2$lld, є %1$lld). Доти практика йде на словах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只用已解锁字母的句子还不够（需要 %2$lld 句，目前 %1$lld 句）。在此之前会继续练习单词。"
          }
        }
      }
    },
