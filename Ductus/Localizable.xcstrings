            "value" : "GitHub neodpověděl podle očekávání. Zkuste to za chvíli znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub hat nicht wie erwartet geantwortet. Versuch es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GitHub δεν απάντησε όπως αναμενόταν. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub did not answer as expected. Try again in a little while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub no ha respondido como se esperaba. Vuelve a intentarlo en un rato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پاسخ GitHub آن‌طور که انتظار می‌رفت نبود. کمی بعد دوباره امتحان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub n’a pas répondu comme prévu. Réessayez dans un moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub לא ענה כמצופה. נסה שוב בעוד זמן מה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ने अपेक्षित जवाब नहीं दिया। थोड़ी देर बाद फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GitHub nem a várt módon válaszolt. Próbáld újra egy kicsit később."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub non ha risposto come previsto. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubから想定どおりの応答がありませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub에서 예상한 응답이 오지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub gaf niet het verwachte antwoord. Probeer het over een tijdje opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub nie odpowiedział zgodnie z oczekiwaniami. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GitHub não respondeu como esperado. Tente novamente daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ответил не так, как ожидалось. Повторите попытку чуть позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub beklendiği gibi yanıt vermedi. Biraz sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub відповів не так, як очікувалося. Спробуйте ще раз трохи згодом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub 的响应与预期不符。请稍后再试。"
          }
        }
      }
    },
