    "Type on the 2-Set Korean layout. Each block fills in as you type its keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit der koreanischen 2-Set-Belegung. Jeder Block füllt sich, während du seine Tasten tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type on the 2-Set Korean layout. Each block fills in as you type its keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe con la distribución coreana 2-Set. Cada bloque se completa a medida que escribes sus teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
