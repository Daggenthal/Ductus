    "The adaptive approach was inspired by keybr.com. No code from it is used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der adaptive Ansatz ist von keybr.com inspiriert. Es wird kein Code daraus verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The adaptive approach was inspired by keybr.com. No code from it is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enfoque adaptativo se inspira en keybr.com. No se usa nada de su código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approche adaptative s’inspire de keybr.com. Aucun code n’en est repris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approccio adattivo si ispira a keybr.com. Non ne viene usato alcun codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適応型の手法はkeybr.comを参考にしました。そのコードは使用していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형 방식은 keybr.com에서 아이디어를 얻었습니다. 그 코드는 사용하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De adaptieve aanpak is geïnspireerd op keybr.com. Er wordt geen code ervan gebruikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A abordagem adaptativa foi inspirada no keybr.com. Nenhum código dele é usado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自适应方法受 keybr.com 启发，未使用其任何代码。"
          }
        }
      }
    },
    "The clock starts on your first key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit läuft ab deiner ersten Taste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock starts on your first key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj empieza con tu primera tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chrono démarre à votre première touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cronometro parte al primo tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のキーを押すと計測が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 키를 누르면 시간이 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klok start bij je eerste toets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio começa na sua primeira tecla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下第一个键时开始计时。"
          }
        }
      }
    },
    "The download did not match its checksum, so it was deleted. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download passte nicht zu seiner Prüfsumme und wurde gelöscht. Versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download did not match its checksum, so it was deleted. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no coincidía con su suma de verificación, así que se ha eliminado. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne correspondait pas à sa somme de contrôle, il a donc été supprimé. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download non corrispondeva al checksum, quindi è stato eliminato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルがチェックサムと一致しなかったため、削除しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 파일이 체크섬과 일치하지 않아 삭제했습니다. 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De download kwam niet overeen met de checksum en is daarom verwijderd. Probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não correspondeu ao checksum, então foi apagado. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的文件与校验和不符，已删除。请重试。"
          }
        }
      }
    },
    "The latest release could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Version konnte nicht gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest release could not be read."
          }
        },
        "es": {
