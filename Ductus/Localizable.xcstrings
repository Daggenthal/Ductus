          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen in andere apps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitação em outros apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 App 中打字"
          }
        }
      }
    },
    "Typing in other apps: macOS asks for the Input Monitoring permission again after each update, because this version of Ductus is not notarized by Apple yet. Turn Ductus back on in System Settings › Privacy & Security › Input Monitoring.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen in anderen Apps: macOS fragt nach jedem Update erneut nach der Berechtigung „Eingabeüberwachung“, weil diese Version von Ductus noch nicht von Apple notarisiert ist. Aktiviere Ductus wieder unter Systemeinstellungen › Datenschutz & Sicherheit › Eingabeüberwachung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing in other apps: macOS asks for the Input Monitoring permission again after each update, because this version of Ductus is not notarized by Apple yet. Turn Ductus back on in System Settings › Privacy & Security › Input Monitoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir en otras apps: macOS vuelve a pedir el permiso de Monitorización de entrada tras cada actualización, porque esta versión de Ductus aún no está notarizada por Apple. Vuelve a activar Ductus en Ajustes del Sistema › Privacidad y seguridad › Monitorización de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappe dans les autres apps : macOS redemande l’autorisation Surveillance de l’entrée après chaque mise à jour, car cette version de Ductus n’est pas encore notariée par Apple. Réactivez Ductus dans Réglages Système › Confidentialité et sécurité › Surveillance de l’entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrittura in altre app: macOS chiede di nuovo il permesso Monitoraggio input dopo ogni aggiornamento, perché questa versione di Ductus non è ancora notarizzata da Apple. Riattiva Ductus in Impostazioni di Sistema › Privacy e sicurezza › Monitoraggio input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリでの入力: このバージョンのDuctusはまだAppleの公証を受けていないため、アップデートのたびにmacOSが入力監視の許可を再度求めます。「システム設定」›「プライバシーとセキュリティ」›「入力監視」でDuctusをもう一度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 입력: 이 버전의 Ductus는 아직 Apple의 공증을 받지 않았기 때문에, 업데이트할 때마다 macOS가 입력 모니터링 권한을 다시 요청합니다. 시스템 설정 › 개인정보 보호 및 보안 › 입력 모니터링에서 Ductus를 다시 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen in andere apps: macOS vraagt na elke update opnieuw om toestemming voor invoermonitoring, omdat deze versie van Ductus nog niet door Apple notarieel is bekrachtigd. Zet Ductus weer aan in Systeeminstellingen › Privacy en beveiliging › Invoermonitoring."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitação em outros apps: o macOS pede de novo a permissão Monitoramento de Entrada após cada atualização, porque esta versão do Ductus ainda não foi autenticada pela Apple. Ative o Ductus de novo em Ajustes do Sistema › Privacidade e Segurança › Monitoramento de Entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 App 中打字：由于此版本的 Ductus 尚未经过 Apple 公证，每次更新后 macOS 都会再次请求“输入监控”权限。请在“系统设置”›“隐私与安全性”›“输入监控”中重新打开 Ductus。"
          }
        }
      }
    },
