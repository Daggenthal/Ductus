    "Japanese and Chinese you paste into the Text tab are read with the text tools built into macOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقرأ النصوص اليابانية والصينية التي تلصقها في علامة تبويب النص باستخدام أدوات النصوص المدمجة في macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japonský a čínský text vložený na kartě Text se čte pomocí textových nástrojů vestavěných v macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japanisch und Chinesisch, das du im Tab „Text“ einfügst, wird mit den in macOS integrierten Textwerkzeugen gelesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ιαπωνικά και κινεζικά που επικολλάτε στην καρτέλα «Κείμενο» διαβάζονται με τα εργαλεία κειμένου που είναι ενσωματωμένα στο macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japanese and Chinese you paste into the Text tab are read with the text tools built into macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El japonés y el chino que pegues en la pestaña Texto se leen con las herramientas de texto integradas en macOS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متن ژاپنی و چینی که در زبانهٔ «متن» می‌چسبانید با ابزارهای متنی داخلی macOS خوانده می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le japonais et le chinois collés dans l’onglet Texte sont lus avec les outils de texte intégrés à macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טקסט ביפנית ובסינית שמדביקים בכרטיסייה ״טקסט״ נקרא בעזרת כלי הטקסט המובנים ב-macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाठ टैब में चिपकाई गई जापानी और चीनी को macOS में बने टेक्स्ट टूल से पढ़ा जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Szöveg lapra beillesztett japán és kínai szöveget a macOS beépített szövegeszközei olvassák be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il giapponese e il cinese che incolli nella scheda Testo vengono letti con gli strumenti di testo integrati in macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「テキスト」タブに貼り付けた日本語と中国語は、macOSに内蔵されたテキストツールで読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 탭에 붙여넣은 일본어와 중국어는 macOS에 내장된 텍스트 도구로 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japans en Chinees dat je in de tab Tekst plakt, wordt gelezen met de teksttools die in macOS zijn ingebouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst japoński i chiński wklejony na karcie Tekst jest odczytywany za pomocą narzędzi tekstowych wbudowanych w macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japonês e chinês colados na aba Texto são lidos com as ferramentas de texto integradas ao macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Японский и китайский текст, вставленный во вкладку «Текст», читается встроенными в macOS инструментами для текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin sekmesine yapıştırdığınız Japonca ve Çince metinler macOS'e yerleşik metin araçlarıyla okunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Японський і китайський текст, вставлений на вкладці «Текст», читається вбудованими в macOS інструментами для тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴到“文本”标签页的日文和中文，会用 macOS 内置的文本工具来读取。"
