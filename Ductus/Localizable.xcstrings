    "Permission not granted yet. Turn on Ductus in Input Monitoring, then quit and reopen Ductus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُمنح الإذن بعد. شغّل Ductus في مراقبة الإدخال، ثم أنهِ Ductus وأعد فتحه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávnění zatím nebylo uděleno. Zapněte Ductus ve Sledování vstupu, pak Ductus ukončete a znovu otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigung noch nicht erteilt. Aktiviere Ductus unter „Eingabeüberwachung“, beende Ductus dann und öffne es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άδεια δεν έχει δοθεί ακόμα. Ενεργοποιήστε το Ductus στην Παρακολούθηση εισόδου, μετά τερματίστε και ανοίξτε ξανά το Ductus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission not granted yet. Turn on Ductus in Input Monitoring, then quit and reopen Ductus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha concedido el permiso. Activa Ductus en Monitorización de entrada y luego cierra y vuelve a abrir Ductus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز اجازه داده نشده است. Ductus را در «نظارت بر ورودی» روشن کنید، سپس از Ductus خارج شوید و دوباره بازش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation pas encore accordée. Activez Ductus dans Surveillance de l’entrée, puis quittez et rouvrez Ductus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההרשאה עדיין לא ניתנה. הפעל את Ductus ב״ניטור קלט״, ואז צא מ-Ductus ופתח אותו מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति अभी नहीं दी गई है। इनपुट मॉनिटरिंग में Ductus चालू करें, फिर Ductus को बंद करके दोबारा खोलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az engedély még nincs megadva. Kapcsold be a Ductust a Bemenetfigyelés alatt, majd lépj ki a Ductusból, és nyisd meg újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesso non ancora concesso. Attiva Ductus in Monitoraggio input, poi esci e riapri Ductus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ許可されていません。入力監視でDuctusをオンにしてから、Ductusを終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 권한이 없습니다. 입력 모니터링에서 Ductus를 켠 다음, Ductus를 종료하고 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming nog niet gegeven. Zet Ductus aan bij Invoermonitoring, stop dan Ductus en open het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienie nie zostało jeszcze nadane. Włącz Ductus w Monitorowaniu wprowadzania, a następnie zakończ i ponownie otwórz Ductus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão ainda não concedida. Ative o Ductus em Monitoramento de Entrada, depois encerre e reabra o Ductus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение пока не выдано. Включите Ductus в разделе «Мониторинг ввода», затем закройте и снова откройте Ductus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin henüz verilmedi. Girdi İzleme'de Ductus'u açın, sonra Ductus'tan çıkıp yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвіл ще не надано. Увімкніть Ductus у розділі «Моніторинг введення», потім закрийте й знову відкрийте Ductus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未获得权限。请在“输入监控”中打开 Ductus，然后退出并重新打开 Ductus。"
          }
        }
      }
    },
