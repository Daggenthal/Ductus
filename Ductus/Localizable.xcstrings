    "Sentences from Tatoeba (tatoeba.org) under CC BY 2.0 FR, by these contributors. Each sentence's ID and author is listed in the credits files in the source code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze von Tatoeba (tatoeba.org) unter CC BY 2.0 FR, von diesen Mitwirkenden. ID und Autor jedes Satzes stehen in den Credits-Dateien im Quellcode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentences from Tatoeba (tatoeba.org) under CC BY 2.0 FR, by these contributors. Each sentence's ID and author is listed in the credits files in the source code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frases de Tatoeba (tatoeba.org) con licencia CC BY 2.0 FR, de estos colaboradores. El ID y el autor de cada frase figuran en los archivos de créditos del código fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phrases de Tatoeba (tatoeba.org) sous licence CC BY 2.0 FR, par ces contributeurs. L’ID et l’auteur de chaque phrase figurent dans les fichiers de crédits du code source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasi da Tatoeba (tatoeba.org) con licenza CC BY 2.0 FR, di questi contributori. L'ID e l'autore di ogni frase sono elencati nei file dei riconoscimenti nel codice sorgente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文はTatoeba（tatoeba.org）のもので、CC BY 2.0 FRのもと、以下の投稿者によるものです。各文のIDと作者は、ソースコード内のクレジットファイルに記載されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장은 Tatoeba(tatoeba.org)에서 CC BY 2.0 FR에 따라 가져왔으며, 아래 기여자들이 작성했습니다. 각 문장의 ID와 작성자는 소스 코드의 크레딧 파일에 나와 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinnen van Tatoeba (tatoeba.org) onder CC BY 2.0 FR, door deze bijdragers. De ID en auteur van elke zin staan in de creditsbestanden in de broncode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frases do Tatoeba (tatoeba.org) sob CC BY 2.0 FR, destes colaboradores. O ID e o autor de cada frase estão listados nos arquivos de créditos no código-fonte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "句子来自 Tatoeba（tatoeba.org），按 CC BY 2.0 FR 使用，作者为以下贡献者。每个句子的 ID 和作者都列在源代码的致谢文件中。"
          }
        }
      }
    },
